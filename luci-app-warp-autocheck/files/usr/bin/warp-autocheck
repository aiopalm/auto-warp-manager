#!/bin/sh
# warp-autocheck — проверка доступности и автозамена WARP-конфига (AmneziaWG)
# Команды: status | check | run | regen | log

# --- пути (переопределяются тестами) ---------------------------------------
WAC_STATE_FILE="${WAC_STATE_FILE:-/tmp/warp-autocheck.state}"
WAC_LOG_FILE="${WAC_LOG_FILE:-/tmp/warp-autocheck.log}"
WAC_LOCK_FILE="${WAC_LOCK_FILE:-/tmp/warp-autocheck.lock}"
WAC_UPTIME_FILE="${WAC_UPTIME_FILE:-/proc/uptime}"
WAC_CONF_OVERRIDE="${WAC_CONF_OVERRIDE:-}"   # тестовый хук: путь к WARP.conf

# --- константы (из Zapret-Manager, извлечены дословно) ----------------------
AWG_WARP_PEER="bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo="
RU_COLOS="DME SVX LED KJA REN OVB KZN AER VVO"
AWG_TEST_HOSTS="162.159.192.1 188.114.97.1 188.114.96.3 162.159.193.2 162.159.195.2 188.114.98.2 188.114.99.2 8.6.112.2 8.34.70.2 8.34.146.2 8.39.125.2"
AWG_TEST_PORTS="2408 500 4500 1701"
AWG_BOOT_PRIV="4OnO86dDLpqJ2U10ODwX3tarx6xlRGLfkmbSBtMgaHg="
AWG_BOOT_IP="172.16.0.3"
AWG_CF_VER="a-6.11-2223"
AWG_I1_HOSTS="www.apple.com www.google.com www.microsoft.com cdn.jsdelivr.net"
ST_WARP_POOLS="188.114.96. 188.114.97. 188.114.98. 188.114.99. 162.159.192. 162.159.193. 162.159.195. 8.34.70. 8.34.146. 8.39.214. 8.39.204. 8.6.112. 8.35.211. 8.39.125. 8.47.69."
WARP_PRIMARY="https://santa-atmo.ru/warp/warp.php"
MIXOMO_AWG_JC=4
MIXOMO_AWG_JMIN=40
MIXOMO_AWG_JMAX=70
MIXOMO_AWG_H1=1
MIXOMO_AWG_H2=2
MIXOMO_AWG_H3=3
MIXOMO_AWG_H4=4
MIXOMO_AWG_S1=0
MIXOMO_AWG_S2=0
AWG_I1_ICLOUD="<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>"
AWG_I1_QUIC1="<b >"
MIXOMO_AWG_I1="<b >"
ST_WARP_PORTS_EXT="854 859 864 878 880 890 891 894 903 908 928 934 939 942 943 945 946 955 968 987 988 1002 1010 1014 1018 1070 1074 1180 1387 1843 2371 2506 3138 3476 3581 3854 4177 4198 4233 5279 5956 7103 7152 7156 7281 7559 8319 8742 8854 8886"



# --- утилиты ---------------------------------------------------------------
AWG_TEST_IF="wac-test"
AWG_TRY_WAIT=8
AWG_API="https://api.cloudflareclient.com/v0a4005/reg"
WARP_PRIMARY="$MIXOMO_WARP_PRIMARY"
AWG_RUN_DIR="${WAC_RUN_DIR:-/tmp/warp-autocheck.run}"

log() {
	echo "$(date '+%Y-%m-%dT%H:%M:%S') $*" >> "$WAC_LOG_FILE" 2>/dev/null
	logger -t warp-autocheck "$*" 2>/dev/null
	return 0
}

cfg_get() { uci -q get "warp-autocheck.main.$1"; }

state_get() { [ -f "$WAC_STATE_FILE" ] && sed -n "s/^$1=//p" "$WAC_STATE_FILE" | tail -n1; }

state_set() {
	: > "$WAC_STATE_FILE.tmp"
	touch "$WAC_STATE_FILE"
	while IFS='=' read -r k v; do
		[ "$k" = "$1" ] && continue
		[ -n "$k" ] && echo "$k=$v" >> "$WAC_STATE_FILE.tmp"
	done < "$WAC_STATE_FILE"
	echo "$1=$2" >> "$WAC_STATE_FILE.tmp"
	mv -f "$WAC_STATE_FILE.tmp" "$WAC_STATE_FILE"
}

esc() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\t\r\n'
}

uptime_now() {
	[ -f "$WAC_UPTIME_FILE" ] || { echo 0; return 0; }
	awk '{ print int($1) }' "$WAC_UPTIME_FILE" 2>/dev/null
}

lock_alive() {
	[ -f "$WAC_LOCK_FILE" ] || return 1
	pid=$(cat "$WAC_LOCK_FILE" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) rm -f "$WAC_LOCK_FILE"; return 1 ;; esac
	if kill -0 "$pid" 2>/dev/null; then return 0; else rm -f "$WAC_LOCK_FILE"; return 1; fi
}

acquire_lock() {
	if lock_alive; then
		# наш собственный lock (вложенный вызов) — не блокируем
		[ "$(cat "$WAC_LOCK_FILE" 2>/dev/null)" = "$$" ] && return 0
		return 1
	fi
	echo $$ > "$WAC_LOCK_FILE"
	WAC_LOCK_HELD=1
	return 0
}

release_lock() {
	[ "$WAC_LOCK_HELD" = "1" ] || return 0
	rm -f "$WAC_LOCK_FILE"
	WAC_LOCK_HELD=0
	return 0
}

# --- amneziawg-хелперы ------------------------------------------------------
# peer-секция интерфейса в uci network: секция типа amneziawg_<iface>
peer_sec() {
	uci -q -X show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=amneziawg_$1\$/\1/p" | head -n1
}

iface_exists() {
	[ "$(uci -q get "network.$1.proto" 2>/dev/null)" = "amneziawg" ]
}

iface_manual_off() {
	[ "$(uci -q get "network.$1.auto" 2>/dev/null)" = "0" ] && [ ! -d "/sys/class/net/$1" ]
}

endpoint_of() { # iface
	local p host port
	p=$(peer_sec "$1") || return 1
	[ -n "$p" ] || return 1
	host=$(uci -q get "network.$p.endpoint_host")
	port=$(uci -q get "network.$p.endpoint_port")
	[ -n "$host" ] || return 1
	case "$host" in
		*:*) echo "[$host]:${port:-2408}" ;;
		*) echo "$host:${port:-2408}" ;;
	esac
}

hs_age_of() { # iface -> возраст рукопожатия (сек) или пусто
	local hs ts
	hs=$(awg show "$1" latest-handshakes 2>/dev/null | awk '$2 > 0 { print $2; exit }')
	[ -n "$hs" ] || return 0
	ts=$(date +%s)
	echo $(( ts - hs ))
}

hs_age_of() { # iface -> возраст рукопожатия (сек) или пусто
	local hs ts
	hs=$(awg show "$1" latest-handshakes 2>/dev/null | awk '$2 > 0 { print $2; exit }')
	[ -n "$hs" ] || return 0
	ts=$(date +%s)
	echo $(( ts - hs ))
}

# --- проверка доступности ---------------------------------------------------
is_ru() { # colo [country]
	case " $RU_COLOS " in *" $1 "*) return 0 ;; esac
	[ "$2" = "RU" ] && return 0
	return 1
}

wan_ok() {
	local tr
	tr=$(curl -s --connect-timeout 5 --max-time 10 "http://1.1.1.1/cdn-cgi/trace" 2>/dev/null)
	[ -n "$tr" ] && return 0
	tr=$(curl -s --connect-timeout 5 --max-time 10 -o /dev/null -w '%{http_code}' "http://connectivity-check.ubuntu.com/" 2>/dev/null)
	[ "$tr" = "204" ] && return 0
	return 1
}

_cf_meta() { # [iface] -> "colo country cca2 city"
	local j c s k t ifargs=""
	[ -n "$1" ] && ifargs="--interface $1"
	j=$(curl -s $ifargs --connect-timeout 4 --max-time 8 -H 'Referer: https://speed.cloudflare.com' https://speed.cloudflare.com/meta 2>/dev/null)
	case "$j" in *'"colo"'*) ;; *) return 1 ;; esac
	c="$(jsonfilter -s "$j" -e '@.colo.iata' 2>/dev/null)"
	[ -n "$c" ] || c="$(jsonfilter -s "$j" -e '@.colo' 2>/dev/null | grep -E '^[A-Z]{3}$')"
	[ -n "$c" ] || return 1
	s="$(jsonfilter -s "$j" -e '@.country' 2>/dev/null)"
	k="$(jsonfilter -s "$j" -e '@.colo.cca2' 2>/dev/null)"
	t="$(jsonfilter -s "$j" -e '@.colo.city' 2>/dev/null | tr -d '"\\\t\r\n')"
	echo "$c ${s:--} ${k:--} ${t:--}"
}

_wac_probe() { # iface -> "loss rtt torn"
	local out
	out=$(ping -I "$1" -c 10 -i 0.2 -W 2 -w 8 1.1.1.1 2>/dev/null)
	case "$out" in *"packet loss"*) ;; *) out=$(ping -I "$1" -c 5 -W 2 -w 10 1.1.1.1 2>/dev/null) ;; esac
	case "$out" in *" 100% packet loss"*|'') out=$(ping -I "$1" -c 10 -i 0.2 -W 2 -w 8 8.8.8.8 2>/dev/null) ;; esac
	printf '%s\n' "$out" | awk -v t=3 '
		/seq=[0-9]/ { s = $0; sub(/.*seq=/, "", s); sub(/[^0-9].*/, "", s); s += 0; if (!got++ || s > hi) hi = s }
		/packets transmitted/ { tx = $1 + 0 }
		/packet loss/ { l = $0; sub(/%.*/, "", l); sub(/.*[^0-9]/, "", l); loss = l + 0; have = 1 }
		/min\/avg/ { v = $0; sub(/.*= */, "", v); split(v, a, "/"); rtt = int(a[2]) }
		END {
			if (!have) loss = 100
			torn = (got > 0 && tx > 0 && tx - 1 - hi >= t) ? 1 : 0
			printf "%d %d %d\n", loss, (got > 0 && rtt > 0 ? rtt : 99999), torn
		}'
}

_wac_trace_ip() { # iface -> "ip warp [colo country cca2 city]" (или пусто)
	local tr ip warp meta
	tr=$(curl -s --interface "$1" --connect-timeout 4 --max-time 6 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)
	[ -n "$tr" ] || tr=$(curl -s --interface "$1" --connect-timeout 4 --max-time 6 https://1.1.1.1/cdn-cgi/trace 2>/dev/null)
	ip=$(printf '%s\n' "$tr" | sed -n 's/^ip=//p' | head -n1)
	warp=$(printf '%s\n' "$tr" | sed -n 's/^warp=//p' | head -n1)
	if [ -z "$ip" ]; then
		tr=$(curl -s --interface "$1" --connect-timeout 3 --max-time 5 https://ipinfo.io/json 2>/dev/null)
		ip=$(printf '%s' "$tr" | jsonfilter -e '@.ip' 2>/dev/null)
	fi
	[ -z "$ip" ] && ip=$(curl -s --interface "$1" --connect-timeout 3 --max-time 5 https://api.ipify.org 2>/dev/null | grep -Eo '^[0-9a-fA-F.:]{3,45}$' | head -n1)
	[ -z "$ip" ] && return 1
	meta="$(_cf_meta "$1")"
	echo "$ip ${warp:-unknown} ${meta:-- - - -}"
}

iface_check() { # iface -> stdout "result|detail"
	local out ip warp colo country loss rtt torn
	out=$(_wac_trace_ip "$1")
	ip=$(printf '%s\n' "$out" | awk '{print $1}')
	warp=$(printf '%s\n' "$out" | awk '{print $2}')
	colo=$(printf '%s\n' "$out" | awk '{print $3}')
	country=$(printf '%s\n' "$out" | awk '{print $4}')
	[ -n "$ip" ] || { echo "no-link|внешний IP через туннель не получен"; return 0; }
	case "$warp" in on|plus) ;; *) echo "no-link|trace warp=${warp:-нет}"; return 0 ;; esac
	set -- $(_wac_probe "$1")
	loss="$1"; rtt="$2"; torn="$3"
	if [ "${loss:-100}" -ge 100 ] 2>/dev/null; then echo "no-link|трафик через туннель не идёт (потери 100%)"; return 0; fi
	if [ "$torn" = "1" ]; then echo "torn|потери ${loss}%, ${rtt} мс — поток обрывается (DPI)"; return 0; fi
	if is_ru "$colo" "$country"; then echo "ru-colo|трафик идёт через российский узел ${colo:-?}"; return 0; fi
	echo "ok|выход $ip, узел ${colo:-?}, потери ${loss}%, ${rtt} мс"
}

cmd_check() {
	local conf iface res detail fails now ts
	local prev_held="$WAC_LOCK_HELD"
	if ! acquire_lock; then
		printf '{"result":"busy","detail":"операция уже выполняется"}\n'
		return 0
	fi
	local fresh=0
	[ "$WAC_LOCK_HELD" = "1" ] && [ "$prev_held" != "1" ] && fresh=1

	conf=$(cfg_get conf 2>/dev/null); [ -n "$conf" ] || conf="/root/WARP.conf"
	[ -n "$WAC_CONF_OVERRIDE" ] && conf="$WAC_CONF_OVERRIDE"
	iface=$(cfg_get interface 2>/dev/null); [ -n "$iface" ] || iface="warp"

	ts=$(date +%s)
	if ! iface_exists "$iface"; then
		res="no-iface"; detail="интерфейс $iface не найден или не amneziawg"
	elif iface_manual_off "$iface"; then
		res="manual-off"; detail="интерфейс $iface выключен вручную"
	elif ! wan_ok; then
		res="wan-down"; detail="интернет недоступен — проверка отложена"
	else
		out=$(iface_check "$iface")
		res="${out%%|*}"; detail="${out#*|}"
	fi

	fails=$(state_get fails); case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
	case "$res" in
		ok|ru-colo) fails=0 ;;   # ru-colo — рабочий вариант для владельца, не смерть конфига
		no-link|torn) fails=$((fails + 1)) ;;
	esac

	state_set last_check "$ts"
	state_set last_result "$res"
	state_set last_detail "$detail"
	state_set fails "$fails"

	log "check: $res ($detail), fails=$fails"
	printf '{"result":"%s","detail":"%s","fails":%s}\n' "$(esc "$res")" "$(esc "$detail")" "$fails"
	[ "$fresh" = "1" ] && release_lock
	return 0
}

# --- генерация с подбором ---------------------------------------------------
_i1_hex() { if command -v hexdump >/dev/null 2>&1; then hexdump -ve '1/1 "%02x"'; else od -An -v -tx1 | tr -d ' \n'; fi; }
_i1_num() {
	awk -v a="$1" -v b="$2" -v s="$(head -c 4 /dev/urandom | _i1_hex)" 'BEGIN { x = 0; for (i = 1; i <= length(s); i++) x = x * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1; srand(x); print a + int(rand() * (b - a + 1)) }'
}
_i1_str() { tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null | head -c "$1"; }
_i1_host() { set -- $AWG_I1_HOSTS; eval "echo \"\${$(_i1_num 1 $#)}\""; }
_i1_dns() {
	local h="$(_i1_host)" q="" l p
	for l in $(echo "$h" | tr '.' ' '); do q="$q$(printf '%02x' "${#l}")$(printf '%s' "$l" | _i1_hex)"; done
	p="$(_i1_num 60 180)"
	printf '<r 2><b 0x01000001000000000001%s0000010001000029100000000000%04x000c%04x><r %d>' "$q" $((p + 4)) "$p" "$p"
}
_i1_stun() {
	local s
	s=$(( $(_i1_num 4 8) * 4 ))
	printf '<b 0x0001%04x2112a442><r 12><b 0x8022%04x%s>' $((s + 4)) "$s" "$(_i1_str "$s" | _i1_hex)"
}
_i1_sip() {
	local h="$(_i1_host)"
	printf '<b 0x%s>' "$(printf '%s\r\n' \
		"OPTIONS sip:$h SIP/2.0" \
		"Via: SIP/2.0/UDP 192.168.$(_i1_num 0 255).$(_i1_num 2 254):5060;branch=z9hG4bK$(_i1_str 10)" \
		"From: <sip:$(_i1_str 8)@$h>;tag=$(_i1_num 100000 999999)" \
		"To: <sip:$h>" \
		"Call-ID: $(_i1_str 16)@$h" \
		"CSeq: $(_i1_num 1000 9999) OPTIONS" \
		"Max-Forwards: 70" \
		"User-Agent: PJSIP/2.13" \
		"Content-Length: 0" \
		"" | _i1_hex)"
}

AWG_NO_I1=0
try_conf() { # dev priv ip endpoint mask [peer] -> 0 hs ok / 1 нет / 2 модуль не загружен
	local dev="$1" conf="$AWG_RUN_DIR/try.conf" hs i=0 i1="$5" peer="${6:-$AWG_WARP_PEER}"
	AWG_NO_I1=0
	ip link del "$dev" >/dev/null 2>&1
	ip link add dev "$dev" type amneziawg >/dev/null 2>&1 || return 2
	ip link set "$dev" mtu 1280 >/dev/null 2>&1
	ip addr add "$3/32" dev "$dev" >/dev/null 2>&1
	ip link set "$dev" up >/dev/null 2>&1
	printf '%s\n' "[Interface]" "PrivateKey = $2" \
		"Jc = $MIXOMO_AWG_JC" "Jmin = $MIXOMO_AWG_JMIN" "Jmax = $MIXOMO_AWG_JMAX" "S1 = $MIXOMO_AWG_S1" "S2 = $MIXOMO_AWG_S2" \
		"H1 = $MIXOMO_AWG_H1" "H2 = $MIXOMO_AWG_H2" "H3 = $MIXOMO_AWG_H3" "H4 = $MIXOMO_AWG_H4" ${i1:+"I1 = $i1"} "" \
		"[Peer]" "PublicKey = $peer" "AllowedIPs = 0.0.0.0/0" "Endpoint = $4" "PersistentKeepalive = 5" > "$conf"
	if ! awg setconf "$dev" "$conf" >/dev/null 2>&1; then
		if [ -n "$i1" ] && sed -i '/^I1 = /d' "$conf" 2>/dev/null && awg setconf "$dev" "$conf" >/dev/null 2>&1; then
			AWG_NO_I1=1
			log "модуль AmneziaWG не знает маску I1 — пробуем без неё"
		else
			rm -f "$conf"; return 1
		fi
	fi
	rm -f "$conf"
	while [ "$i" -lt "$AWG_TRY_WAIT" ]; do
		hs=$(awg show "$dev" latest-handshakes 2>/dev/null | awk '{ print $2; exit }')
		[ "${hs:-0}" -gt 0 ] 2>/dev/null && return 0
		sleep 0.5 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	return 1
}

try_down() { ip link del "$1" >/dev/null 2>&1; }

_cf_api_ip() { # [curl-args] -> IP api.cloudflareclient.com через DoH (обходит DNS-подмену провайдера)
	local j ip ifargs=""
	[ -n "$1" ] && ifargs="--interface $1"
	j=$(curl -s $ifargs --connect-timeout 4 --max-time 8 -H 'accept: application/dns-json' "https://1.1.1.1/dns-query?name=api.cloudflareclient.com&type=A" 2>/dev/null)
	ip=$(printf '%s' "$j" | grep -o '"data":"[0-9.]*"' | head -n1 | grep -o '[0-9.]*')
	[ -n "$ip" ] && echo "$ip"
}

_cf_api_ok() { # [curl-args] -> код не 000? (с DoH-resolve против DNS-подмены)
	local ip ipargs=""
	ip=$(_cf_api_ip "$@") && ipargs="--resolve api.cloudflareclient.com:443:$ip"
	local code
	code=$(curl -s --connect-timeout 5 --max-time 8 "$@" $ipargs -o /dev/null -w '%{http_code}' "$AWG_API/" 2>/dev/null)
	[ -n "$code" ] && [ "$code" != "000" ]
}

keys_register() { # [curl-args] -> G_PRIV/G_PEER/G_V4/G_V6
	local reg="$AWG_RUN_DIR/reg.$$" api code id tok
	local K_PRIV K_PUB
	mkdir -p "$AWG_RUN_DIR"
	K_PRIV=$(awg genkey 2>/dev/null)
	[ -n "$K_PRIV" ] || { log "нет утилиты awg"; return 1; }
	K_PUB=$(printf '%s' "$K_PRIV" | awg pubkey 2>/dev/null)
	[ -n "$K_PUB" ] || { log "awg pubkey не сработал"; return 1; }
	G_PRIV="$K_PRIV"; G_PUB="$K_PUB"

	# 1) Cloudflare API напрямую (или через переданные curl-args); IP — через DoH, против DNS-подмены
	local ipargs=""
	ip=$(_cf_api_ip "$@") && ipargs="--resolve api.cloudflareclient.com:443:$ip"
	[ -n "$ipargs" ] && log "API: IP получен через DoH, идём напрямую на него"
	rm -f "$reg"
	code=$(curl -s --connect-timeout 6 --max-time 25 "$@" $ipargs -X POST \
		-H 'Content-Type: application/json' -H "User-Agent: okhttp/3.12.1" -H "CF-Client-Version: $AWG_CF_VER" -H 'Accept-Encoding: identity' \
		-d "{\"key\":\"$G_PUB\",\"install_id\":\"\",\"fcm_token\":\"\",\"tos\":\"$(date -u +%Y-%m-%dT%H:%M:%S.000Z)\",\"type\":\"Android\",\"model\":\"\",\"locale\":\"en_US\"}" \
		-o "$reg" -w '%{http_code}' "$AWG_API" 2>/dev/null)
	case "$code" in
		200|201)
			id=$(jsonfilter -i "$reg" -e '@.result.id' 2>/dev/null)
			tok=$(jsonfilter -i "$reg" -e '@.result.token' 2>/dev/null)
			G_PEER=$(jsonfilter -i "$reg" -e '@.result.config.peers[0].public_key' 2>/dev/null)
			G_V4=$(jsonfilter -i "$reg" -e '@.result.config.interface.addresses.v4' 2>/dev/null)
			G_V6=$(jsonfilter -i "$reg" -e '@.result.config.interface.addresses.v6' 2>/dev/null)
			if [ -n "$id" ] && [ -n "$tok" ]; then
				code=$(curl -s --connect-timeout 6 --max-time 15 "$@" $ipargs -X PATCH \
					-H 'Content-Type: application/json' -H "User-Agent: okhttp/3.12.1" -H "CF-Client-Version: $AWG_CF_VER" -H "Authorization: Bearer $tok" \
					-d '{"warp_enabled":true}' -o /dev/null -w '%{http_code}' "$AWG_API/$id" 2>/dev/null)
				case "$code" in
					2??) rm -f "$reg"; log "ключи выданы Cloudflare"; return 0 ;;
					*) log "Cloudflare: ключ выдан, WARP не включился ($code)" ;;
				esac
			else
				log "Cloudflare: в ответе нет id/token"
			fi
			;;
		*) log "Cloudflare: ответ ${code:-нет связи}" ;;
	esac
	rm -f "$reg"

	# 2) внешний генератор (его собственная пара ключей, как в ZM)
	reg="$AWG_RUN_DIR/ext.$$"
	if curl -fsSL --connect-timeout 10 --max-time 30 "$WARP_PRIMARY" -o "$reg" 2>/dev/null; then
		E_PRIV=$(grep -o '"key"[[:space:]]*:[[:space:]]*"[^"]*"' "$reg" 2>/dev/null | head -n1 | sed 's/.*:[[:space:]]*"//;s/"$//')
		E_PEER=$(grep -o '"public_key"[[:space:]]*:[[:space:]]*"[^"]*"' "$reg" 2>/dev/null | head -n1 | sed 's/.*:[[:space:]]*"//;s/"$//')
		E_V4=$(grep -o '"v4"[[:space:]]*:[[:space:]]*"[^"]*"' "$reg" 2>/dev/null | sed -n '2p' | sed 's/.*:[[:space:]]*"//;s/"$//')
		E_V6=$(grep -o '"v6"[[:space:]]*:[[:space:]]*"[^"]*"' "$reg" 2>/dev/null | sed -n '2p' | sed 's/.*:[[:space:]]*"//;s/"$//')
		rm -f "$reg"
		[ -n "$E_PRIV" ] && [ -n "$E_PEER" ] && [ -n "$E_V4" ] && {
			G_PRIV="$E_PRIV"; G_PEER="$E_PEER"; G_V4="$E_V4"; G_V6="$E_V6"
			log "ключи получены от внешнего генератора"; return 0
		}
		log "внешний генератор: в ответе нет ключей"
	else
		log "внешний генератор не ответил"
	fi

	# 3) через живой amneziawg-интерфейс (как в ZM: провайдер часто закрывает API напрямую)
	local i a
	for i in $(uci -q show network 2>/dev/null | sed -n "s/^network\.\([a-z0-9_]*\)\.proto='amneziawg'\$/\1/p"); do
		a=$(hs_age_of "$i")
		case "$a" in ''|*[!0-9]*) continue ;; esac
		[ "$a" -lt 180 ] 2>/dev/null || continue
		if _cf_api_ok "--interface $i"; then
			log "Cloudflare доступен через туннель $i — регистрируем через него"
			keys_register "--interface $i" && return 0
		else
			log "туннель $i жив, но API через него недоступен"
		fi
	done

	# 4) временный boot-туннель на общих ключах
	log "прямые пути не сработали — поднимаем временный туннель на общих ключах"
	local host port m
	for host in 188.114.96.3 162.159.192.1 188.114.97.1; do
		for port in $AWG_TEST_PORTS; do
			for m in "$MIXOMO_AWG_I1" "$AWG_I1_ICLOUD" "$AWG_I1_QUIC1"; do
				try_conf "$AWG_TEST_IF" "$AWG_BOOT_PRIV" "$AWG_BOOT_IP" "$host:$port" "$m" || continue
				if _cf_api_ok "--interface $AWG_TEST_IF"; then
					try_down "$AWG_TEST_IF"
					log "boot-туннель поднят: $host:$port"
					keys_register "--interface $AWG_TEST_IF" && return 0
					return 1
				fi
				try_down "$AWG_TEST_IF"
			done
		done
	done
	return 1
}

_rand_hosts() { # n -> случайные hosts из пулов
	awk -v n="$1" -v pools="$ST_WARP_POOLS" -v seed="$(date +%s)$$" 'BEGIN {
		srand(seed); c = split(pools, p, " ")
		for (i = 1; i <= c; i++) for (k = 0; k < n; k++) printf "%s%d\n", p[i], 2 + int(rand() * 253)
	}' | sort -u
}

_warp_conf_i1() { # текущая маска из WARP.conf
	[ -n "$CONF_FILE" ] && [ -f "$CONF_FILE" ] && sed -n 's/^I1 = //p' "$CONF_FILE" | head -n1
}

pick_endpoint() { # priv v4 [hint_ep] [hint_mask] -> BEST_EP/BEST_MASK; 0 найдено / 1 нет
	local priv="$1" v4="$2" host port m ep
	local t0=$(date +%s) tries=0 mn=0
	local masks="" cur
	cur="$(_warp_conf_i1)"
	[ -n "$cur" ] && masks="$cur"
	masks="$masks
$MIXOMO_AWG_I1
$AWG_I1_ICLOUD
$AWG_I1_QUIC1
$(_i1_dns)
$(_i1_stun)
$(_i1_sip)"
	local h1="${BEST_HINT_EP%%:*}"
	[ -n "$h1" ] || h1="${AWG_TEST_HOSTS%% *}"
	local hosts="$h1 $AWG_TEST_HOSTS $(_rand_hosts 2)"
	log "подбор точки входа: до 80 попыток, лимит 7 минут"

	for host in $hosts; do
		for port in $AWG_TEST_PORTS; do
			ep="$host:$port"
			local nl='
'
			local oifs="$IFS"
			IFS="$nl"
			for m in $masks; do
				IFS="$oifs"
				mn=$((mn + 1))
				[ "$mn" -gt 7 ] && mn=1
				tries=$((tries + 1))
				[ "$tries" -gt 80 ] && return 1
				[ $(( $(date +%s) - t0 )) -gt 420 ] && return 1
				if try_conf "$AWG_TEST_IF" "$priv" "$v4" "$ep" "$m" "$G_PEER"; then
					log "попытка $tries: $ep, маска #$mn — рукопожатие есть"
					# трафик реально идёт через туннель? (trace, как _awg_trace в ZM)
					local tout
					tout=$(_wac_trace_ip "$AWG_TEST_IF") || { log "   $ep — trace не прошёл"; continue; }
					local tip twarp tcolo
					tip=$(printf '%s\n' "$tout" | awk '{print $1}')
					twarp=$(printf '%s\n' "$tout" | awk '{print $2}')
					tcolo=$(printf '%s\n' "$tout" | awk '{print $3}')
					[ -n "$tip" ] || { log "   $ep — рукопожатие есть, trace не идёт"; continue; }
					case "$twarp" in on|plus) ;; *) log "   $ep — trace warp=${twarp:-нет}"; continue ;; esac
					set -- $(_wac_probe "$AWG_TEST_IF")
					local loss="$1" torn="$3"
					[ "${loss:-100}" -ge 100 ] 2>/dev/null && { log "   $ep — рукопожатие есть, трафика нет"; continue; }
					[ "$torn" = "1" ] && { log "   $ep — трафик обрывается (DPI)"; continue; }
					BEST_EP="$ep"; BEST_MASK="$m"
					log "   $ep — трафик идёт: узел ${tcolo:-?}$([ "$tcolo" != '-' ] && is_ru "$tcolo" && echo ' (RU)')"
					log "найдена точка: $ep, маска #$mn"
					return 0
				else
					log "попытка $tries: $ep, маска #$mn — нет ответа"
				fi
			done
			IFS="$oifs"
		done
	done
	return 1
}

conf_write() { # priv peer v4 v6 endpoint mask outfile
	printf '%s\n' \
		"[Interface]" "PrivateKey = $1" "Address = ${3}${4:+, $4}" "DNS = 1.1.1.1, 1.0.0.1" "MTU = 1280" \
		"S1 = $MIXOMO_AWG_S1" "S2 = $MIXOMO_AWG_S2" "Jc = $MIXOMO_AWG_JC" "Jmin = $MIXOMO_AWG_JMIN" "Jmax = $MIXOMO_AWG_JMAX" \
		"H1 = $MIXOMO_AWG_H1" "H2 = $MIXOMO_AWG_H2" "H3 = $MIXOMO_AWG_H3" "H4 = $MIXOMO_AWG_H4" "I1 = ${6:-$MIXOMO_AWG_I1}" "" \
		"[Peer]" "PublicKey = $2" "AllowedIPs = 0.0.0.0/0, ::/0" "Endpoint = $5" "PersistentKeepalive = 25" \
		> "$7"
	chmod 600 "$7" 2>/dev/null
}

uci_snapshot() { # outfile — сохранить текущие ключи интерфейса для отката
	local p; p=$(peer_sec "$IFACE")
	{
		echo "network.$IFACE.private_key=$(uci -q get "network.$IFACE.private_key")"
		if [ -n "$p" ]; then
			echo "network.$p.public_key=$(uci -q get "network.$p.public_key")"
			echo "network.$p.endpoint_host=$(uci -q get "network.$p.endpoint_host")"
			echo "network.$p.endpoint_port=$(uci -q get "network.$p.endpoint_port")"
		fi
		for o in awg_jc awg_jmin awg_jmax awg_s1 awg_s2 awg_h1 awg_h2 awg_h3 awg_h4 awg_i1; do
			echo "network.$IFACE.$o=$(uci -q get "network.$IFACE.$o")"
		done
	} > "$1"
}

uci_restore() { # infile — откат
	local kv k v p
	p=$(peer_sec "$IFACE")
	while IFS='=' read -r kv v; do
		[ -n "$kv" ] || continue
		case "$kv" in
			network.*.*)
				k="${kv#network.}"; k="${k#*.}"
				sec="${kv#network.}"; sec="${sec%%.*}"
				if [ "$sec" = "$IFACE" ] || [ "$sec" = "$p" ]; then
					uci set "$kv=$v"
				fi
				;;
		esac
	done < "$1"
	uci commit network
}

apply_iface() { # conf iface — применить ключи/endpoint/маски из нового конфига
	local conf="$1" iface="$2" p priv pub ep host port mask
	p=$(peer_sec "$iface")
	[ -n "$p" ] || { p="${iface}_peer"; uci set "network.$p=amneziawg_$iface"; }
	priv=$(awk '/^\[Interface\]/{s=1;next}/^\[/{s=0}s && /^PrivateKey = /{print substr($0, 14); exit}' "$conf")
	pub=$(awk '/^\[Peer\]/{s=1;next}/^\[/{s=0}s && /^PublicKey = /{print substr($0, 13); exit}' "$conf")
	ep=$(awk '/^\[Peer\]/{s=1;next}/^\[/{s=0}s && /^Endpoint = /{print substr($0, 12); exit}' "$conf")
	mask=$(sed -n 's/^I1 = //p' "$conf" | head -n1)
	[ -n "$priv" ] && [ -n "$pub" ] && [ -n "$ep" ] || return 1
	case "$ep" in
		\[*\]:*) host="${ep%]:*}"; host="${host#\[}"; port="${ep##*]:}" ;;
		?*:*) host="${ep%:*}"; port="${ep##*:}" ;;
		*) return 1 ;;
	esac
	uci set "network.$iface.private_key=$priv"
	uci set "network.$p.public_key=$pub"
	uci set "network.$p.endpoint_host=$host"
	uci set "network.$p.endpoint_port=$port"
	# параметры маскировки — константы пакета
	uci set "network.$iface.awg_jc=$MIXOMO_AWG_JC"
	uci set "network.$iface.awg_jmin=$MIXOMO_AWG_JMIN"
	uci set "network.$iface.awg_jmax=$MIXOMO_AWG_JMAX"
	uci set "network.$iface.awg_s1=$MIXOMO_AWG_S1"
	uci set "network.$iface.awg_s2=$MIXOMO_AWG_S2"
	uci set "network.$iface.awg_h1=$MIXOMO_AWG_H1"
	uci set "network.$iface.awg_h2=$MIXOMO_AWG_H2"
	uci set "network.$iface.awg_h3=$MIXOMO_AWG_H3"
	uci set "network.$iface.awg_h4=$MIXOMO_AWG_H4"
	[ -n "$mask" ] && uci set "network.$iface.awg_i1=$mask" || uci -q delete "network.$iface.awg_i1"
	uci commit network
	return 0
}

cmd_regen() {
	local conf iface res detail now
	conf=$(cfg_get conf 2>/dev/null); [ -n "$conf" ] || conf="/root/WARP.conf"
	[ -n "$WAC_CONF_OVERRIDE" ] && conf="$WAC_CONF_OVERRIDE"
	CONF_FILE="$conf"
	iface=$(cfg_get interface 2>/dev/null); [ -n "$iface" ] || iface="warp"
	IFACE="$iface"

	if ! acquire_lock; then
		printf '{"result":"skipped:busy"}\n'; return 0
	fi
	G_PRIV=""; G_PEER=""; G_V4=""; G_V6=""; BEST_EP=""; BEST_MASK=""
	G_PUB=""; BEST_HINT_EP=""

	if ! iface_exists "$iface" || iface_manual_off "$iface"; then
		release_lock
		printf '{"result":"skipped:no-iface"}\n'; return 0
	fi

	log "regen: Шаг 1 из 2 — получаем ключи WARP"
	if ! keys_register; then
		release_lock
		log "regen: ключи получить не удалось"
		state_set last_result "regen-failed"
		state_set last_detail "ключи WARP получить не удалось — ни один источник не ответил"
		printf '{"result":"regen-failed"}\n'
		return 0
	fi
	log "regen: ключи получены, адрес $G_V4"
	log "regen: Шаг 2 из 2 — ищем рабочую точку входа и маску"

	if ! pick_endpoint "$G_PRIV" "$G_V4"; then
		try_down "$AWG_TEST_IF"
		release_lock
		log "regen: зарубежная точка не найдена — старый конфиг не трогаем"
		state_set last_result "not-helped"
		state_set last_detail "зарубежных точек нет — конфиг не заменён"
		printf '{"result":"not-helped"}\n'
		return 0
	fi
	try_down "$AWG_TEST_IF"

	local newconf="$conf.new"
	conf_write "$G_PRIV" "$G_PEER" "$G_V4" "$G_V6" "$BEST_EP" "$BEST_MASK" "$newconf"

	# бэкап + атомарная замена
	cp -f "$conf" "$conf.bak" 2>/dev/null
	uci_snapshot "$conf.bak.uci"
	mv -f "$newconf" "$conf"
	chmod 600 "$conf" 2>/dev/null
	log "regen: конфиг заменен, точка $BEST_EP, применяем интерфейс $iface"

	if ! apply_iface "$conf" "$iface"; then
		release_lock
		log "regen: не удалось применить конфиг к интерфейсу — откат"
		cp -f "$conf.bak" "$conf" 2>/dev/null
		uci_restore "$conf.bak.uci"
		ifup "$iface" >/dev/null 2>&1
		state_set last_result "rolled-back"
		printf '{"result":"rolled-back"}\n'
		return 0
	fi
	ifup "$iface" >/dev/null 2>&1

	sleep 15
	out=$(iface_check "$iface")
	res="${out%%|*}"; detail="${out#*|}"
	release_lock
	if [ "$res" = "ok" ] || [ "$res" = "ru-colo" ]; then
		state_set fails 0
		state_set last_replace "$(date +%s)"
		state_set last_result "replaced"
		state_set last_detail "новый конфиг: $detail"
		log "regen: готово — $detail"
		printf '{"result":"replaced","detail":"%s"}\n' "$(esc "$detail")"
	else
		log "regen: пост-проверка не прошла ($detail) — откат на старый конфиг"
		cp -f "$conf.bak" "$conf" 2>/dev/null
		uci_restore "$conf.bak.uci"
		ifup "$iface" >/dev/null 2>&1
		state_set last_result "rolled-back"
		state_set last_detail "новый конфиг не заработал ($detail) — откат"
		printf '{"result":"rolled-back"}\n'
	fi
	return 0
}

cmd_status() {
	local conf iface conf_exists=false iface_exists=false manual_off=false
	local endpoint="" hs_age="" enabled=false interval=6 retries=2
	local last_check=0 last_result="none" last_detail="" last_replace=0 fails=0 running=false uptime

	conf=$(cfg_get conf 2>/dev/null); [ -n "$conf" ] || conf="/root/WARP.conf"
	[ -n "$WAC_CONF_OVERRIDE" ] && conf="$WAC_CONF_OVERRIDE"
	iface=$(cfg_get interface 2>/dev/null); [ -n "$iface" ] || iface="warp"

	[ -s "$conf" ] && conf_exists=true
	if iface_exists "$iface"; then
		iface_exists=true
		endpoint=$(endpoint_of "$iface")
		hs_age=$(hs_age_of "$iface")
		iface_manual_off "$iface" && manual_off=true
	fi
	[ "$(cfg_get enabled 2>/dev/null)" = "1" ] && enabled=true
	interval=$(cfg_get interval 2>/dev/null); case "$interval" in ''|*[!0-9]*) interval=6 ;; esac
	retries=$(cfg_get retries 2>/dev/null); case "$retries" in ''|*[!0-9]*) retries=2 ;; esac

	last_check=$(state_get last_check); case "$last_check" in ''|*[!0-9]*) last_check=0 ;; esac
	last_result=$(state_get last_result); [ -n "$last_result" ] || last_result="none"
	last_detail=$(state_get last_detail)
	last_replace=$(state_get last_replace); case "$last_replace" in ''|*[!0-9]*) last_replace=0 ;; esac
	fails=$(state_get fails); case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
	lock_alive && running=true
	uptime=$(uptime_now)

	printf '{"conf_exists":%s,"iface":"%s","iface_exists":%s,"iface_manual_off":%s,"endpoint":"%s","hs_age":%s,"enabled":%s,"interval":%s,"retries":%s,"conf":"%s","last_check":%s,"last_result":"%s","last_detail":"%s","last_replace":%s,"fails":%s,"running":%s,"uptime":%s}\n' \
		"$conf_exists" "$(esc "$iface")" "$iface_exists" "$manual_off" "$(esc "$endpoint")" \
		"${hs_age:-null}" "$enabled" "$interval" "$retries" "$(esc "$conf")" \
		"$last_check" "$(esc "$last_result")" "$(esc "$last_detail")" "$last_replace" "$fails" \
		"$running" "${uptime:-0}"
}

# --- settings ----------------------------------------------------------------
get_settings() {
	local enabled=false interval=6 interface="warp" retries=2 conf
	[ "$(cfg_get enabled 2>/dev/null)" = "1" ] && enabled=true
	interval=$(cfg_get interval 2>/dev/null); case "$interval" in ''|*[!0-9]*) interval=6 ;; esac
	interface=$(cfg_get interface 2>/dev/null); [ -n "$interface" ] || interface="warp"
	retries=$(cfg_get retries 2>/dev/null); case "$retries" in ''|*[!0-9]*) retries=2 ;; esac
	conf=$(cfg_get conf 2>/dev/null); [ -n "$conf" ] || conf="/root/WARP.conf"
	printf '{"enabled":%s,"interval":%s,"interface":"%s","retries":%s,"conf":"%s"}\n' \
		"$enabled" "$interval" "$(esc "$interface")" "$retries" "$(esc "$conf")"
}

set_settings() { # enabled interval interface retries
	local enabled="$1" interval="$2" interface="$3" retries="$4"
	case "$enabled" in 0|1) ;; *) printf '{"error":"enabled: 0 или 1"}\n'; return 1 ;; esac
	case "$interval" in ''|*[!0-9]*) printf '{"error":"интервал: часы (1–168)"}\n'; return 1 ;; esac
	[ "$interval" -ge 1 ] 2>/dev/null && [ "$interval" -le 168 ] 2>/dev/null || { printf '{"error":"интервал: часы (1–168)"}\n'; return 1; }
	if ! printf '%s' "$interface" | LC_ALL=C grep -qE '^[a-z][a-z0-9_]{0,10}$'; then
		printf '{"error":"имя интерфейса: латиница в нижнем регистре, цифры и _, до 11 символов"}\n'; return 1
	fi
	case "$retries" in ''|*[!0-9]*) printf '{"error":"повторы: 0–3"}\n'; return 1 ;; esac
	[ "$retries" -le 3 ] 2>/dev/null || { printf '{"error":"повторы: 0–3"}\n'; return 1; }
	uci set "warp-autocheck.main.enabled=$enabled"
	uci set "warp-autocheck.main.interval=$interval"
	uci set "warp-autocheck.main.interface=$interface"
	uci set "warp-autocheck.main.retries=$retries"
	uci commit warp-autocheck
	log "settings: enabled=$enabled interval=$interval interface=$interface retries=$retries"
	printf '{"ok":true}\n'
}

# --- log --------------------------------------------------------------------
cmd_log() {
	[ -f "$WAC_LOG_FILE" ] || return 0
	tail -n 100 "$WAC_LOG_FILE"
}

# --- main -------------------------------------------------------------------
cmd_run() {
	! acquire_lock && return 0
	local enabled up interval now last out res attempt=0 max retries
	enabled=$(cfg_get enabled 2>/dev/null)
	[ "$enabled" = "1" ] || { release_lock; return 0; }
	up=$(uptime_now)
	[ "${up:-0}" -ge 900 ] || { release_lock; log "run: грейс после загрузки (${up:-0} сек) — пропуск"; return 0; }
	interval=$(cfg_get interval 2>/dev/null); case "$interval" in ''|*[!0-9]*) interval=6 ;; esac
	now=$(date +%s)
	last=$(state_get last_check); case "$last" in ''|*[!0-9]*) last=0 ;; esac
	[ $((now - last)) -ge $((interval * 3600 - 300)) ] || { release_lock; return 0; }

	retries=$(cfg_get retries 2>/dev/null); case "$retries" in ''|*[!0-9]*) retries=2 ;; esac
	max=$((retries + 1))
	while [ "$attempt" -lt "$max" ]; do
		out=$(cmd_check)
		res=$(printf '%s' "$out" | sed -n 's/.*"result":"\([^"]*\)".*/\1/p')
		case "$res" in
			no-link|torn)
				attempt=$((attempt + 1))
				[ "$attempt" -lt "$max" ] && sleep 300
				;;
			*) release_lock; return 0 ;;
		esac
	done
	log "run: конфиг мертв после $max проверок — запускаем регенерацию"
	cmd_regen
	release_lock
	return 0
}

case "$1" in
	status) cmd_status ;;
	log) cmd_log ;;
	check) cmd_check ;;
	get_settings) get_settings ;;
	set_settings) shift; set_settings "$@" ;;
	regen) cmd_regen ;;
	run) cmd_run ;;
	*) echo "usage: warp-autocheck {status|check|run|regen|log}" >&2; exit 1 ;;
esac
