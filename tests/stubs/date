#!/bin/sh
# Стаб date: время из WAC_TEST_ROOT/clock (epoch), иначе системное
# Поддержка: +%s, -u +FMT
ROOT="${WAC_TEST_ROOT:?WAC_TEST_ROOT not set}"
REAL_DATE=/bin/date
[ -x "$REAL_DATE" ] || REAL_DATE=$(command -v date | grep -v "tests/stubs" | head -n1)
FMT=""
NOWARG=""
for a in "$@"; do
	case "$a" in
		+%s) FMT="epoch" ;;
		-u) NOWARG=1 ;;
		+*) FMT="${a#+}" ;;
	esac
done

if [ -f "$ROOT/clock" ]; then
	EPOCH=$(cat "$ROOT/clock")
else
	if [ "$FMT" = "epoch" ]; then
		"$REAL_DATE" +%s
		exit 0
	else
		"$REAL_DATE" "$@"
		exit 0
	fi
fi

case "$FMT" in
	epoch) echo "$EPOCH" ;;
	*) "$REAL_DATE" -u -r "$EPOCH" "+$FMT" 2>/dev/null || "$REAL_DATE" -u "+$FMT" ;;
esac
